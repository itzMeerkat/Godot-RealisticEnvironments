[layer_names]

3d_physics/layer_2="Projectile"
3d_physics/layer_3="Hitbox"

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true

[shader_globals]

atmosphere_enabled={
"type": "bool",
"value": false
}
atmosphere_view_transmittance={
"type": "sampler3D",
"value": ""
}
atmosphere_view_inscatter={
"type": "sampler3D",
"value": ""
}
atmosphere_view_inscatter_lobe={
"type": "sampler3D",
"value": ""
}
atmosphere_observer={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
atmosphere_light={
"type": "vec4",
"value": Vector4(0, 1, 0, 0.97)
}
atmosphere_max_distance={
"type": "float",
"value": 100000.0
}
atmosphere_exposure={
"type": "float",
"value": 1.0
}
