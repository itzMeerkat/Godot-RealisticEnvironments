/*
 * The cloud layer: its density field, its light and the march along a view ray. Shared
 * by cloud_raymarch.glsl (the cubemaps) and cloud_trace.glsl (the camera's view), which
 * bind these resources at set 0, bindings 1-5.
 *
 * Cloud space: world x and z, and y the altitude above the sea (GRESkySystem.sea_level).
 * The planet is a sphere of radius CLOUD_PLANET_RADIUS (the atmosphere's) whose surface
 * is the sea; the layer is a spherical shell between params.layer.x and .y, so it bends
 * down to the horizon. An observer may be anywhere: below, inside or above the layer.
 * Local up at the observer is +y.
 *
 * Droplet optics: Henyey-Greenstein phase (g = march.w, about 0.85) and the preset's
 * scattering albedo. The phase's forward peak (g^2 of it) sends light on almost
 * unchanged, so light transport sees the cloud thinner (delta-Eddington, transport
 * extinction (1 - albedo g^2) of the true one):
 *   single scattering: the key light down the light march, the true beam with the
 *     whole phase, and what the peak scattered on the way (the transport beam less
 *     the true one) with the phase's broad rest;
 *   every higher order: the delta-Eddington two-stream field of the local column
 *     (optical depth above and below the sample, measured straight up and down),
 *     lit by the key light and by the sky's light falling on its top and bottom; seen
 *     from above it gives the bright tops (the field going up), from below the grey
 *     bases (the field going down);
 *   in-scatter reaches the observer through the transport extinction, and the sky
 *     behind the cloud that the peak scatters only slightly is added to it; the
 *     opacity is the true one (consumers show the sky and the sun's disk behind
 *     through it).
 * Checked against a Monte Carlo reference of uniform layers (optical depth 2-100, sun
 * 15-60 degrees, sky light, seen from below): within about 0.8-1.3, except within a few
 * degrees of the sun behind thin cloud, where the glow comes out up to 4x too bright (the
 * peak's small deflections spread it there).
 *
 * Light: the key light above the atmosphere, dimmed down to each sample by the
 * atmosphere along the light's path there (the transmittance LUT, with the planet's
 * shadow): far clouds toward a low sun see it higher and whiter than those away from it,
 * and stay lit after the observer's sunset. Plus the sky's light at the layer from above
 * and below (GREAtmosphereRenderer.sky_ambient_buffer). Output, as seen at the cloud: rgb in-scattered
 * radiance (premultiplied), a opacity; the atmosphere between the observer and the
 * clouds is left to the consumers.
 */

#define CLOUD_PI 3.14159265359
// As ATMOSPHERE_EARTH_RADIUS (atmosphere_common.glslinc): consumers split the atmosphere
// at the clouds' distance.
#define CLOUD_PLANET_RADIUS 6371000.0
// Samples of the local column above and below a sample (cheap density).
#define CLOUD_COLUMN_STEPS_ABOVE 3
#define CLOUD_COLUMN_STEPS_BELOW 2
// Largest shift (in shape-noise tiles) of the shape noise by the weather's warp.
#define CLOUD_SHAPE_WARP 0.35

layout(set = 0, binding = 1) uniform sampler3D shape_noise;
layout(set = 0, binding = 2) uniform sampler3D detail_noise;
layout(set = 0, binding = 3) uniform sampler2D weather_map;
// GRECloudRenderer._pack_params().
layout(set = 0, binding = 4, std430) restrict readonly buffer CloudParams {
	vec4 layer;           // x base altitude, y top altitude (m above the sea), z max distance, w the atmosphere's top altitude (m)
	vec4 weather_area;    // xy map centre (world XZ), z map extent (m), w extinction at density 1 (1/m)
	vec4 motion;          // xy wind offset (world XZ, m), z evolution time, w sky light scale
	vec4 scales;          // x shape tile (m), y detail tile (m), z detail erosion, w scattering albedo
	vec4 light_direction; // xyz unit vector toward the key light (sun or moon), w the haze's wavelength exponent (atmosphere_haze_spectrum())
	vec4 light_color;     // rgb key light above the atmosphere: irradiance / pi (the light's energy)
	vec4 march;           // x view steps, y light steps, z longest light march (m), w phase g
} params;
// GREAtmosphereRenderer.sky_ambient_buffer (atmosphere_ambient.glsl).
layout(set = 0, binding = 5, std430) restrict readonly buffer SkyAmbient {
	vec4 above; // rgb mean radiance of the sky above the layer
	vec4 below; // rgb mean radiance of the sky and sea below it
	vec4 irradiance; // unused here
	vec4 cloud_light; // unused here
} sky_ambient;
// GREAtmosphereRenderer's transmittance LUT. The includer defines CLOUD_TRANSMITTANCE_BINDING
// and includes atmosphere_common.glslinc first (the importer expands only the shader's own
// includes, not nested ones).
layout(set = 0, binding = CLOUD_TRANSMITTANCE_BINDING) uniform sampler2D transmittance_lut;

float cloud_remap(float value, float old_min, float old_max, float new_min, float new_max) {
	return new_min + (value - old_min) / (old_max - old_min) * (new_max - new_min);
}

float cloud_hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

// Distances along a ray to the sphere at `altitude`, for a ray starting at
// `origin_altitude` whose direction makes cosine `mu` with the local up.
// Factored so that planet-sized radii keep their precision. y < 0: no hit ahead.
vec2 cloud_shell_intersection(float origin_altitude, float mu, float altitude) {
	float b = (CLOUD_PLANET_RADIUS + origin_altitude) * mu;
	float c = (origin_altitude - altitude) * (2.0 * CLOUD_PLANET_RADIUS + origin_altitude + altitude);
	float discriminant = b * b - c;
	if (discriminant < 0.0) {
		return vec2(-1.0);
	}
	float s = sqrt(discriminant);
	return vec2(-b - s, -b + s);
}

// Altitude after distance t along a ray from origin_altitude with cosine mu.
float cloud_altitude_along_ray(float origin_altitude, float mu, float t) {
	float r0 = CLOUD_PLANET_RADIUS + origin_altitude;
	float q = t * (2.0 * r0 * mu + t); // r^2 - r0^2
	return origin_altitude + q / (sqrt(r0 * r0 + q) + r0);
}

/*
 * The ray's stretches inside the cloud layer, up to t_limit (and the layer's max
 * distance, and the sea): xy the first, zw the second (empty where start >= end). A ray
 * from above or inside the layer may dip below its base and come out again.
 */
vec4 cloud_ray_segments(float h, float mu, float t_limit) {
	vec2 top = cloud_shell_intersection(h, mu, params.layer.y);
	if (top.y <= 0.0) {
		return vec4(0.0);
	}
	float enter = max(top.x, 0.0);
	float leave = top.y;
	float limit = min(t_limit, params.layer.z);
	vec2 sea = cloud_shell_intersection(h, mu, 0.0);
	if (sea.x > 0.0) {
		limit = min(limit, sea.x);
	}
	vec4 segments = vec4(enter, leave, leave, leave);
	vec2 base = cloud_shell_intersection(h, mu, params.layer.x);
	if (base.y > 0.0) {
		// Below the base between base.x and base.y.
		segments = vec4(enter, min(leave, base.x), max(enter, base.y), leave);
	}
	return min(segments, vec4(limit));
}

vec4 cloud_sample_weather(vec2 world_xz) {
	vec2 uv = (world_xz - params.weather_area.xy) / params.weather_area.z + 0.5;
	return textureLod(weather_map, uv, 0.0);
}

// Fraction of the layer a cloud of this type fills: stratus stays low and
// thin, cumulonimbus reaches the top. Flat bases, rounded tops.
float cloud_height_gradient(float height_fraction, float cloud_type) {
	float top = mix(0.22, 1.0, cloud_type);
	float base = smoothstep(0.0, 0.06, height_fraction);
	float crown = 1.0 - smoothstep(top * 0.45, top, height_fraction);
	return base * crown;
}

float cloud_layer_fraction(float altitude) {
	return (altitude - params.layer.x) / (params.layer.y - params.layer.x);
}

// Cloud density (extinction multiplier) at a cloud-space point. `detailed` adds the
// erosion noise; light rays skip it beyond their first steps.
float cloud_density(vec3 position, float height_fraction, vec4 weather, bool detailed) {
	float coverage = weather.r;
	if (coverage <= 0.001 || height_fraction <= 0.0 || height_fraction >= 1.0) {
		return 0.0;
	}
	vec3 drift = vec3(params.motion.x, 0.0, params.motion.y);
	float evolution = params.motion.z;
	// Rising sample position: cloud features slowly climb through the body. The weather's
	// warp shifts it by up to CLOUD_SHAPE_WARP tiles, differently from tile to tile.
	vec3 shape_position = (position - drift) / params.scales.x - vec3(0.0, evolution * 0.6, 0.0)
			+ vec3(1.0, 0.0, 0.618) * (weather.a * CLOUD_SHAPE_WARP);
	float base = textureLod(shape_noise, shape_position, 0.0).r * cloud_height_gradient(height_fraction, weather.g);
	float covered = clamp(cloud_remap(base, 1.0 - coverage, 1.0, 0.0, 1.0), 0.0, 1.0) * coverage;
	if (covered <= 0.0) {
		return 0.0;
	}
	if (detailed) {
		vec3 detail_position = (position - drift) / params.scales.y - vec3(0.0, evolution * 4.0, 0.0);
		float detail = textureLod(detail_noise, detail_position, 0.0).r;
		// Wispy at the base, billowy higher up.
		float modifier = mix(detail, 1.0 - detail, clamp(height_fraction * 4.0, 0.0, 1.0));
		covered = clamp(cloud_remap(covered, modifier * params.scales.z, 1.0, 0.0, 1.0), 0.0, 1.0);
	}
	return covered * weather.b;
}

// Henyey-Greenstein phase function (1/sr).
float cloud_henyey_greenstein(float cos_theta, float g) {
	float g2 = g * g;
	return (1.0 - g2) / (4.0 * CLOUD_PI * pow(max(1.0 + g2 - 2.0 * g * cos_theta, 1.0e-6), 1.5));
}

// Optical depth toward the key light up to the top of the cloud layer (at most
// march.z away), with steps growing along the ray.
float cloud_light_optical_depth(vec3 position, float altitude) {
	vec3 light_direction = params.light_direction.xyz;
	int steps = int(params.march.y);
	float distance_to_top = min((params.layer.y - altitude) / max(light_direction.y, 0.05), params.march.z);
	// Segments 1, 2, ..., steps times this add up to the distance.
	float step_length = distance_to_top / (0.5 * float(steps * (steps + 1)));
	float travelled = 0.0;
	float optical_depth = 0.0;
	for (int i = 0; i < steps; i++) {
		float segment = step_length * float(i + 1);
		float along = travelled + segment * 0.5;
		float sample_altitude = altitude + light_direction.y * along;
		float height_fraction = cloud_layer_fraction(sample_altitude);
		if (height_fraction >= 1.0 || height_fraction <= 0.0) {
			break;
		}
		vec3 sample_position = position + light_direction * along;
		sample_position.y = sample_altitude;
		optical_depth += cloud_density(sample_position, height_fraction, cloud_sample_weather(sample_position.xz), i < 2) * segment;
		travelled += segment;
	}
	return optical_depth * params.weather_area.w;
}

/*
 * Optical depth of the local column straight above a sample (up to the cloud top) and
 * below it (down to the layer's base): the slab the two-stream field is solved in.
 */
vec2 cloud_column_optical_depths(vec3 position, float altitude, float cloud_top, vec4 weather) {
	float extinction = params.weather_area.w;
	float above = 0.0;
	float span = max(cloud_top - altitude, 0.0) / float(CLOUD_COLUMN_STEPS_ABOVE);
	for (int i = 0; i < CLOUD_COLUMN_STEPS_ABOVE; i++) {
		float sample_altitude = altitude + span * (float(i) + 0.5);
		vec3 sample_position = vec3(position.x, sample_altitude, position.z);
		above += cloud_density(sample_position, cloud_layer_fraction(sample_altitude), weather, false) * span;
	}
	float below = 0.0;
	span = max(altitude - params.layer.x, 0.0) / float(CLOUD_COLUMN_STEPS_BELOW);
	for (int i = 0; i < CLOUD_COLUMN_STEPS_BELOW; i++) {
		float sample_altitude = params.layer.x + span * (float(i) + 0.5);
		vec3 sample_position = vec3(position.x, sample_altitude, position.z);
		below += cloud_density(sample_position, cloud_layer_fraction(sample_altitude), weather, false) * span;
	}
	return vec2(above, below) * extinction;
}

/*
 * The delta-Eddington two-stream field (Joseph, Wiscombe and Weinman 1976) at optical
 * depth tau from the top of a slab of optical depth tau_total (both transport-scaled,
 * scattering albedo omega and phase g of the scaled medium), lit by the sun (flux 1 on
 * a surface facing it, cosine mu0 to the up) and by isotropic radiance 1 falling on
 * the top and on the bottom. Returns the radiance each source scatters into a
 * direction whose cosine to the down is mu_v (> 0 going down, toward an observer
 * below; < 0 going up, toward one above), per unit of scaled extinction: x sun, y top,
 * z bottom.
 */
vec3 cloud_two_stream(float tau_total, float tau, float mu0, float mu_v, float omega, float g) {
	float a = 1.0 - omega * g;
	float b = 3.0 * (1.0 - omega);
	// A floor on the decay rate keeps the system well conditioned for conservative scattering.
	float k = max(sqrt(a * b), 0.01);
	float p = -k / a;
	// Particular solution for the sun: I0 = alpha e, I1 = beta e, e = exp(-tau / mu0).
	float c = 3.0 * omega / (4.0 * CLOUD_PI);
	float d = c * g * mu0;
	float det = a * b - 1.0 / (mu0 * mu0);
	float alpha = (a * c + d / mu0) / det;
	float beta = (c / mu0 + b * d) / det;
	// Homogeneous part I0 = A' e^{k (tau - T)} + B e^{-k tau}, I1 = p (A' e^{k (tau - T)} - B e^{-k tau}),
	// boundaries: diffuse flux in at the top (I0 + 2/3 I1) and at the bottom (I0 - 2/3 I1).
	float e_kt = exp(-k * tau_total);
	float m00 = e_kt * (1.0 + 2.0 / 3.0 * p);
	float m01 = 1.0 - 2.0 / 3.0 * p;
	float inverse_det = 1.0 / (m00 * m00 - m01 * m01);
	float e_top = exp(-tau_total / mu0);
	vec3 rhs_top = vec3(-(alpha + 2.0 / 3.0 * beta), 1.0, 0.0);
	vec3 rhs_bottom = vec3(-(alpha - 2.0 / 3.0 * beta) * e_top, 0.0, 1.0);
	vec3 coefficient_a = (m00 * rhs_top - m01 * rhs_bottom) * inverse_det;
	vec3 coefficient_b = (m00 * rhs_bottom - m01 * rhs_top) * inverse_det;
	float rising = exp(k * (tau - tau_total));
	float falling = exp(-k * tau);
	float e = exp(-tau / mu0);
	vec3 i0 = coefficient_a * rising + coefficient_b * falling + vec3(alpha * e, 0.0, 0.0);
	vec3 i1 = p * (coefficient_a * rising - coefficient_b * falling) + vec3(beta * e, 0.0, 0.0);
	return omega * max(i0 + g * mu_v * i1, vec3(0.0));
}

/*
 * Marches the clouds along a ray from an observer at world XZ origin_xz and altitude h
 * (m above the sea) in world direction `direction`, up to t_limit (m). jitter (0-1)
 * offsets the step pattern. Returns rgb in-scattered radiance (premultiplied) and a
 * opacity, as seen at the cloud; cloud_distance is the opacity-weighted mean distance
 * of the cloud along the ray (-1 without cloud), where consumers split the atmosphere.
 */
vec4 cloud_march(vec2 origin_xz, float h, vec3 direction, float t_limit, float jitter, out float cloud_distance) {
	cloud_distance = -1.0;
	float mu = direction.y;
	vec4 segments = cloud_ray_segments(h, mu, t_limit);
	float first = max(segments.y - segments.x, 0.0);
	float path = first + max(segments.w - segments.z, 0.0);
	if (path <= 0.0) {
		return vec4(0.0);
	}

	// Steps grow with a power of the distance along the path: short near the observer's
	// end of the layer, where the detail is, long far away. Inside the layer, where a
	// cloud around the observer hides everything within some 100 m, the power rises from
	// 2 to 3 to put more steps close by. The pattern is jittered per pixel and frame.
	int steps = int(params.march.x);
	float inside = clamp(min(h - params.layer.x, params.layer.y - h) / 200.0, 0.0, 1.0);
	float power = 2.0 + inside;
	float step_x = 1.0 / float(steps);

	vec3 light_direction = params.light_direction.xyz;
	// Irradiance on a surface facing the light.
	vec3 light_flux = params.light_color.rgb * CLOUD_PI;
	vec3 sky_above = sky_ambient.above.rgb * params.motion.w;
	vec3 sky_below = sky_ambient.below.rgb * params.motion.w;
	float cos_theta = dot(direction, light_direction);
	float haze_spectrum[ATMOSPHERE_SPECTRAL_SAMPLES];
	atmosphere_haze_spectrum(params.light_direction.w, haze_spectrum);
	float g = params.march.w;
	float extinction = params.weather_area.w;
	float albedo = params.scales.w;
	// Delta-Eddington: the peak's share, the transport extinction's share and the scaled medium.
	float peak = g * g;
	float transport_share = 1.0 - albedo * peak;
	float scaled_albedo = (1.0 - peak) * albedo / transport_share;
	float scaled_g = g / (1.0 + g);
	float phase = cloud_henyey_greenstein(cos_theta, g);
	float phase_rest = (1.0 - peak) * cloud_henyey_greenstein(cos_theta, scaled_g);
	float mu0 = max(light_direction.y, 0.05);
	// The light reaching the observer travels along -direction: its cosine to the down.
	float mu_view = direction.y;

	vec3 radiance = vec3(0.0);
	float transmittance = 1.0;
	float transport = 1.0;
	float distance_sum = 0.0;
	for (int i = 0; i < steps; i++) {
		float x = (float(i) + jitter) * step_x;
		float u = path * pow(x, power);
		float t = u < first ? segments.x + u : segments.z + (u - first);
		float step_length = path * (pow(x + step_x, power) - pow(x, power));
		float altitude = cloud_altitude_along_ray(h, mu, t);
		float height_fraction = cloud_layer_fraction(altitude);
		vec2 world_xz = origin_xz + direction.xz * t;
		vec4 weather = cloud_sample_weather(world_xz);
		vec3 position = vec3(world_xz.x, altitude, world_xz.y);
		float density = cloud_density(position, height_fraction, weather, true);
		if (density > 0.0) {
			float sigma_t = density * extinction;
			float light_depth = cloud_light_optical_depth(position, altitude);
			float cloud_top = params.layer.x + (params.layer.y - params.layer.x) * mix(0.22, 1.0, weather.g);
			vec2 column = cloud_column_optical_depths(position, altitude, cloud_top, weather);

			// The light through the atmosphere down to the sample, at its height there: the
			// planet curves under the ray. Its shadow edge is softened over about the sun's
			// disk; clouds stay lit for a while after sunset.
			vec3 local_up = normalize(vec3(direction.x * t, CLOUD_PLANET_RADIUS + h + direction.y * t, direction.z * t));
			float mu_light = dot(local_up, light_direction);
			float horizon_mu = atmosphere_horizon_mu(altitude);
			float light_visibility = smoothstep(horizon_mu - 0.01, horizon_mu + 0.01, mu_light);
			vec3 sun = light_flux * light_visibility * atmosphere_light_transmittance(transmittance_lut, altitude, max(mu_light, horizon_mu), params.layer.w, haze_spectrum);
			// Single scattering, per unit of true extinction.
			float beam = exp(-light_depth);
			float beam_transport = exp(-light_depth * transport_share);
			vec3 source = sun * (albedo * (beam * phase + (beam_transport - beam) * phase_rest));
			// Every higher order: the two-stream field of the column, per unit of true extinction.
			vec3 field = cloud_two_stream((column.x + column.y) * transport_share, column.x * transport_share, mu0, mu_view, scaled_albedo, scaled_g);
			source += transport_share * (sun * field.x + sky_above * field.y + sky_below * field.z);

			// Integrated over the step through the transport extinction.
			float step_transport = exp(-sigma_t * transport_share * step_length);
			radiance += transport * source * (1.0 - step_transport) / transport_share;
			transport *= step_transport;
			float step_transmittance = exp(-sigma_t * step_length);
			distance_sum += transmittance * (1.0 - step_transmittance) * t;
			transmittance *= step_transmittance;
			if (transport < 0.01) {
				break;
			}
		}
	}

	// The sky behind, scattered on by the peak only: it arrives as if through the gaps.
	radiance += (transport - transmittance) * (mu >= 0.0 ? sky_above : sky_below);
	float opacity = 1.0 - transmittance;
	if (opacity > 1e-4) {
		cloud_distance = distance_sum / opacity;
	}
	// What is left is taken as opaque: the sun disk behind is so bright that even 1 %
	// of it would show through as a bright spot.
	if (transmittance < 0.01) {
		opacity = 1.0;
	}
	return vec4(radiance, opacity);
}
